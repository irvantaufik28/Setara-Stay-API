{
  "name": "greenhero-api",
  "version": "1.0.0",
  "description": "Green Hero Darajat API for the admin and booking website",
  "license": "ISC",
  "author": "",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "worker:email": "node --env-file-if-exists=.env --import tsx src/email-worker.ts",
    "worker:reservation": "node --env-file-if-exists=.env --import tsx src/reservation-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:email-worker": "node --env-file-if-exists=.env dist/email-worker.js",
    "start:reservation-worker": "node --env-file-if-exists=.env dist/reservation-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:openrouter": "node --env-file-if-exists=.env --import tsx src/scripts/openrouter-smoke-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:room-status": "node --env-file-if-exists=.env scripts/apply-room-status-history.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:seed:master": "node --env-file-if-exists=.env --import tsx src/db/seed-master.ts",
    "db:seed:hotel": "node --env-file-if-exists=.env --import tsx src/db/seed-hotel.ts",
    "db:seed:web-settings-permission": "node --env-file-if-exists=.env --import tsx src/db/seed-web-settings-permission.ts",
    "format": "prettier --write \"src/**/*.ts\" drizzle.config.ts package.json",
    "format:check": "prettier --check \"src/**/*.ts\" drizzle.config.ts package.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@openrouter/sdk": "^1.4.25",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
