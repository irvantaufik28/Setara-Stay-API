NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://taufik@localhost:5432/postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_TTL_SECONDS=300
SESSION_TTL_SECONDS=43200
CLOUDINARY_URL=
# Alternatively, use all three variables below instead of CLOUDINARY_URL.
CLOUDINARY_URL=
# Optional: protect GET /api/v1/public/reservations/expire-due for an external scheduler.
CRON_SECRET=

# Set all four together when enabling Xendit website checkout. Use https://api.xendit.co for Xendit API. Do not commit actual credentials.
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
WEBSITE_BASE_URL=

# Optional Gmail SMTP delivery for confirmed website reservation vouchers.
# Use a Google App Password, never the primary Gmail password.
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Green Hero Darajat - No Reply
EMAIL_REPLY_TO=

# Optional OpenRouter integration for the read-only AI Hotel Assistant.
# Keep the API key empty in this file and list tool-capable models in fallback order.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_MODEL_ATTEMPTS=3
